{
  "name": "serula-nesting-pro",
  "version": "1.0.0",
  "description": "Serula Nesting Pro - Web tabanlı DXF nesting ve malzeme optimizasyon uygulaması",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm --workspace frontend run dev",
    "build": "npm run build:frontend",
    "build:frontend": "npm --workspace frontend run build",
    "deploy:site": "node scripts/deploy-pages.mjs",
    "watch:site": "node scripts/watch-site.mjs",
    "test": "npm run test:nesting && npm run test:export",
    "test:nesting": "node --import ./tests/nesting/register.mjs tests/nesting/verify.mjs",
    "test:export": "node --import ./tests/nesting/register.mjs tests/nesting/export.mjs && node --import ./tests/nesting/register.mjs tests/nesting/export-primitives.mjs"
  },
  "author": {
    "name": "Muhammet Hasanoğlu"
  },
  "license": "Proprietary",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
