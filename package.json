{
  "name": "serula-nesting-pro",
  "version": "1.0.0",
  "description": "Serula Nesting Pro - Web tabanlı DXF nesting ve malzeme optimizasyon uygulaması",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm --workspace frontend run dev",
    "build": "npm run build:frontend",
    "build:frontend": "npm --workspace frontend run build",
    "deploy:site": "node scripts/deploy-pages.mjs",
    "test": "npm run test:contours && npm run test:gls && npm run test:cavities && npm run test:rotation && npm run test:nesting && npm run test:export && npm run test:native",
    "test:nesting": "node --import ./tests/nesting/register.mjs tests/nesting/verify.mjs",
    "test:export": "node --import ./tests/nesting/register.mjs tests/nesting/export.mjs && node --import ./tests/nesting/register.mjs tests/nesting/export-primitives.mjs && node --import ./tests/nesting/register.mjs tests/nesting/dxf-structure.mjs",
    "test:dxf": "node --import ./tests/nesting/register.mjs tests/nesting/export-primitives.mjs && node --import ./tests/nesting/register.mjs tests/nesting/dxf-structure.mjs",
    "test:rotation": "node --import ./tests/nesting/register.mjs tests/nesting/rotation-modes.mjs",
    "version:next": "node scripts/next-version.mjs",
    "test:cavities": "node --import ./tests/nesting/register.mjs tests/nesting/cavities.mjs",
    "test:gls": "node --import ./tests/nesting/register.mjs tests/nesting/gls.mjs && node --import ./tests/nesting/register.mjs tests/nesting/worker.mjs",
    "benchmark:nesting": "node --import ./tests/nesting/register.mjs tests/nesting/compare-engines.mjs",
    "test:native": "node --import ./tests/nesting/register.mjs tests/nesting/native-clearance.mjs",
    "test:contours": "node --import ./tests/nesting/register.mjs tests/nesting/contours.mjs"
  },
  "author": {
    "name": "Muhammet Hasanoğlu"
  },
  "license": "Proprietary",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "dependencies": {
    "react": "^19.3.0"
  }
}
